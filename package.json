{
  "name": "thu-campus-mcp",
  "version": "1.3.3",
  "private": true,
  "description": "清华校园 MCP 整合包与独立 Agent 应用：网络学堂、清华云盘、荷塘雨课堂、MadModel",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "thu-campus": "bin/thu-campus.mjs"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && npm run test:bundle && npm run test:clients",
    "test:bundle": "node --test test/*.test.mjs",
    "test:clients": "node --test desktop/test/*.test.mjs",
    "app": "node bin/thu-campus.mjs app serve",
    "app:smoke": "node test/app-smoke.mjs",
    "e2e:web": "node scripts/e2e-web.mjs",
    "verify:clients": "node scripts/verify-clients.mjs",
    "verify:release": "node scripts/verify-clients.mjs --strict",
    "check": "npm run typecheck && npm run build && npm test && npm run licenses:check && npm run audit:source",
    "smoke": "npm run smoke --workspaces && node test/smoke.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "audit:source": "node scripts/audit-source.mjs",
    "bundle": "node scripts/bundle.mjs",
    "setup": "npm ci && npm run build && node bin/thu-campus.mjs browser install",
    "bundle:prepared": "node scripts/prepared-bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@thu-campus/browser": "1.0.0",
    "smol-toml": "1.9.1",
    "proper-lockfile": "4.1.2"
  }
}






