{
  "name": "thu-campus-mcp",
  "version": "1.5.0",
  "private": true,
  "description": "清华校园 MCP 整合包与独立 Agent 应用：网络学堂、清华云盘、荷塘雨课堂、MadModel",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "thu-campus": "bin/thu-campus.mjs"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && npm run test:bundle && npm run test:clients",
    "test:bundle": "node --test test/*.test.mjs",
    "test:clients": "node --test desktop/test/*.test.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "coverage:check": "node scripts/coverage.mjs --check 90",
    "app": "node bin/thu-campus.mjs app serve",
    "app:smoke": "node test/app-smoke.mjs",
    "arch:check": "node scripts/check-layers.mjs",
    "arch:baseline": "depcruise --config .dependency-cruiser.cjs lib packages webui --output-type baseline > .dependency-cruiser-known-violations.json",
    "e2e:web": "node scripts/e2e-web.mjs",
    "e2e:stream": "node scripts/e2e-streaming.mjs",
    "e2e:workspace": "node scripts/e2e-workspace.mjs",
    "e2e:sandbox": "node scripts/e2e-sandbox.mjs",
    "e2e:auth-workspace": "node scripts/e2e-auth-workspace.mjs",
    "audit:smells": "node scripts/audit-code-smells.mjs",
    "verify:clients": "node scripts/verify-clients.mjs",
    "verify:release": "node scripts/verify-clients.mjs --strict",
    "check": "npm run typecheck && npm run build && npm test && npm run licenses:check && npm run audit:source && npm run audit:smells && npm run mobile:core:check && npm run audit:ignores",
    "smoke": "npm run smoke --workspaces && node test/smoke.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "audit:source": "node scripts/audit-source.mjs",
    "bundle": "node scripts/bundle.mjs",
    "setup": "npm ci && npm run build && node bin/thu-campus.mjs browser install",
    "bundle:prepared": "node scripts/prepared-bundle.mjs",
    "mobile:core": "node scripts/build-mobile-core.mjs",
    "mobile:core:check": "node scripts/build-mobile-core.mjs --check",
    "audit:ignores": "node scripts/audit-ignores.mjs",
    "probe:live": "node scripts/live-read-probe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@thu-campus/browser": "1.0.0",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.9.1"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.6",
      "minimatch": "11.0.8"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "c8": "12.0.0",
    "dependency-cruiser": "^18.8.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "v8-to-istanbul": "9.3.0"
  }
}
